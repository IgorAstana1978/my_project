{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.local/dinva_quote_invoice_document_v0_1.schema.json",
  "title": "DINVA classic approved quote or invoice document v0.1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "document_family", "document_type", "document_id",
    "document_number", "document_date", "currency", "payer", "object_name",
    "basis", "apparatus_heading", "items", "approved_grand_total_kzt", "vat",
    "amount_words", "terms", "signatures", "approval_provenance"
  ],
  "properties": {
    "schema_version": {"const": "dinva_quote_invoice_document.v0.1"},
    "document_family": {"const": "DINVA_CLASSIC_QUOTE_INVOICE_V0_1"},
    "document_type": {"enum": ["QUOTE", "INVOICE", "QUOTE_INVOICE"]},
    "document_id": {"type": "string", "minLength": 1},
    "document_number": {"type": "string", "minLength": 1},
    "document_date": {"type": "string", "format": "date"},
    "currency": {"const": "KZT"},
    "payer": {"type": "string", "minLength": 1},
    "object_name": {"type": ["string", "null"]},
    "basis": {"type": ["string", "null"]},
    "apparatus_heading": {"type": "string", "minLength": 1},
    "items": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": [
          "position", "name", "unit", "quantity",
          "detailed_technical_composition", "apparatus", "enclosure",
          "approved_unit_price_kzt", "approved_line_total_kzt",
          "approval_reference"
        ],
        "properties": {
          "position": {"type": "integer", "minimum": 1},
          "name": {"type": "string", "minLength": 1},
          "unit": {"type": "string", "minLength": 1},
          "quantity": {"type": "integer", "minimum": 1},
          "detailed_technical_composition": {"type": "string", "minLength": 1},
          "apparatus": {"type": "string", "minLength": 1},
          "enclosure": {"type": "string", "minLength": 1},
          "approved_unit_price_kzt": {"type": "integer", "minimum": 0},
          "approved_line_total_kzt": {"type": "integer", "minimum": 0},
          "approval_reference": {"type": "string", "minLength": 1}
        }
      }
    },
    "approved_grand_total_kzt": {"type": "integer", "minimum": 0},
    "vat": {
      "type": "object", "additionalProperties": false,
      "required": ["rate_percent", "included", "approved_amount_kzt", "approved_text"],
      "properties": {
        "rate_percent": {"type": "integer", "minimum": 0, "maximum": 100},
        "included": {"type": "boolean"},
        "approved_amount_kzt": {"type": "integer", "minimum": 0},
        "approved_text": {"type": "string", "minLength": 1}
      }
    },
    "amount_words": {
      "type": "object", "additionalProperties": false,
      "required": ["amount_kzt", "approved_text"],
      "properties": {
        "amount_kzt": {"type": "integer", "minimum": 0},
        "approved_text": {"type": "string", "minLength": 1}
      }
    },
    "terms": {
      "type": "object", "additionalProperties": false,
      "required": ["payment", "delivery", "manufacturing_lead_time", "validity"],
      "properties": {
        "payment": {"type": "string", "minLength": 1},
        "delivery": {"type": "string", "minLength": 1},
        "manufacturing_lead_time": {"type": "string", "minLength": 1},
        "validity": {"type": ["string", "null"]}
      }
    },
    "signatures": {
      "type": "object", "additionalProperties": false,
      "required": ["director_title", "director_name", "executor_title", "executor_name"],
      "properties": {
        "director_title": {"type": "string", "minLength": 1},
        "director_name": {"type": "string", "minLength": 1},
        "executor_title": {"type": "string", "minLength": 1},
        "executor_name": {"type": "string", "minLength": 1}
      }
    },
    "approval_provenance": {
      "type": "object", "additionalProperties": false,
      "required": [
        "status", "authority", "approval_id", "approved_at",
        "source_sha256s", "rendering_authorized", "client_send_authorized"
      ],
      "properties": {
        "status": {"const": "APPROVED"},
        "authority": {"type": "string", "minLength": 1},
        "approval_id": {"type": "string", "minLength": 1},
        "approved_at": {"type": "string", "minLength": 1},
        "source_sha256s": {
          "type": "array", "minItems": 1,
          "items": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
        },
        "rendering_authorized": {"const": true},
        "client_send_authorized": {"const": false}
      }
    }
  }
}
